# Copy this file to `.env` and fill in your key:  cp .env.example .env

# Generation runs on Groq's free tier. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings run locally and free via sentence-transformers (no key needed).
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional tunables (defaults applied in src/pdfrag/config.py if unset)
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# TOP_K=5
# RELEVANCE_THRESHOLD=0.2
